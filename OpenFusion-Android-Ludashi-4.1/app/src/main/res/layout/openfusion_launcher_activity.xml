<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0B0D12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <ImageView
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="OpenFusion" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OpenFusion Android"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Native launcher · Ludashi compatibility runtime"
            android:textColor="#AEB6C6"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp" />

        <Spinner
            android:id="@+id/OFServerSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#D7DEEA" />

        <EditText
            android:id="@+id/OFUsername"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:hint="Username"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#7F899D"
            android:backgroundTint="#8FA7D8" />

        <EditText
            android:id="@+id/OFPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="Password (leave blank to reuse saved login)"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#7F899D"
            android:backgroundTint="#8FA7D8" />

        <CheckBox
            android:id="@+id/OFRemember"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Remember login"
            android:textColor="#D7DEEA"
            android:buttonTint="#8FA7D8" />

        <Button
            android:id="@+id/OFPlay"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:text="Play FusionFall"
            android:textAllCaps="false"
            android:textSize="18sp" />

        <ProgressBar
            android:id="@+id/OFProgress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/OFStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Preparing…"
            android:textColor="#AEB6C6"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
